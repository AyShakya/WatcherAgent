{
  "name": "guardian",
  "version": "1.0.0",
  "description": "AI-Governed Incident Response for Regulated Financial Systems — Airia Hackathon 2026",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "nodes/*",
    "community/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "demo": "node scripts/trigger-demo.js",
    "seed:confluence": "node scripts/seed-confluence.js",
    "seed:kg": "node scripts/seed-knowledge-graph.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "jest tests/unit/",
    "test:integration": "jest tests/integration/",
    "postmortem:gen": "node scripts/generate-postmortem.js",
    "lint": "eslint nodes/ community/ config/ --ext .js"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "axios": "^1.15.2",
    "discord.js": "^14.26.3",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "octokit": "^5.0.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  }
}
